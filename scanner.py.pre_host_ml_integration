def main():

    while True:

        show_banner()

        show_main_menu()

        choice = input(
            Fore.CYAN
            + "Select module > "
            + Style.RESET_ALL
        ).strip()

        if choice == "1":

            print()

            print(
                Fore.GREEN
                + Style.BRIGHT
                + "[+] Launching Port Scan module..."
                + Style.RESET_ALL
            )

            run_scan()

        elif choice == "2":

            print()

            print(
                Fore.YELLOW
                + Style.BRIGHT
                + "[+] Launching Local Network Discovery..."
                + Style.RESET_ALL
            )

            run_discovery()

        elif choice == "3":

            print()

            print(
                Fore.CYAN
                + Style.BRIGHT
                + "[*] Shutting down SentinelX Security Console..."
                + Style.RESET_ALL
            )

            print()

            break

        else:

            print()

            print(
                Fore.RED
                + "[!] Invalid option. Choose 1, 2, or 3."
                + Style.RESET_ALL
            )

        if choice != "3":

            print()

            input(
                Fore.WHITE
                + "Press Enter to return to Command Center..."
                + Style.RESET_ALL
            )



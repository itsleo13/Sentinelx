            Fore.RED
            + "Could not resolve target."
        )

        return

    hostname, hostname_source = (
        get_hostname(
            resolved_ip
        )
    )

    print()

    print(
        "Profiles: "
        "quick / common / full / custom"
    )

    profile = input(
        "Choose profile: "
    ).strip().lower()

    if profile not in PROFILES and profile != "custom":

        print(
            Fore.RED
            + "Invalid profile."
        )

        return

    if profile == "custom":

        start_port = input(
            "Enter Start Port: "
        ).strip()

        end_port = input(
            "Enter End Port: "
        ).strip()

        if not validate_ports(
            start_port,
            end_port
        ):

            print(
                Fore.RED
                + "Invalid port range."
            )

            return

        start_port = int(
            start_port
        )

        end_port = int(
            end_port
        )

        profile_config = PROFILES[
            "custom"
        ]

    else:

        profile_config = PROFILES[
            profile
        ]

        start_port = profile_config[
            "start"
        ]

        end_port = profile_config[
            "end"
        ]

    ports = list(
        range(
            start_port,
            end_port + 1
        )
    )

    scan_timeout = profile_config.get(
        "timeout",
        DEFAULT_TIMEOUT
    )

    scan_workers = profile_config.get(
        "workers",
        DEFAULT_WORKERS
    )

    print(
        f"Target       : {target}"
    )

    print(
        f"Resolved IP  : {resolved_ip}"
    )

    print(
        f"Hostname     : {hostname}"
    )

    print(
        f"Hostname Src : {hostname_source}"
    )

    print(
        "-" * 60
    )

    start_time = time.time()

    open_ports = scan_target(
        resolved_ip,
        ports,
        timeout=scan_timeout,
        workers=scan_workers
    )

    elapsed = (
        time.time()
        - start_time
    )

    # ========================================================
    # ANALYSIS
    # ========================================================

    scan_data = {

        "target":
            target,

        "resolved_ip":
            resolved_ip,

        "hostname":
            hostname,

        "hostname_source":
            hostname_source,

        "open_ports":
            open_ports

    }

    findings = analyze_scan(
        open_ports
    )

    findings = deduplicate_findings(
        findings
    )

    risk_score = calculate_risk(
        findings
    )

    # ========================================================
    # SUMMARY
    # ========================================================

    scanned_ports = set(
        ports
    )

    open_port_numbers = {
        item["port"]
        for item in open_ports
    }

    closed_ports = sorted(
        scanned_ports
        - open_port_numbers
    )

    print()

    print()

    def summary_row(label, value):
        content = f" {label:<13}{str(value)[:39]}"
        return (
            Fore.CYAN
            + "║"
            + content[:58].ljust(58)
            + "║"
            + Style.RESET_ALL
        )

    print(
        Fore.CYAN
        + "╔══════════════════════════════════════════════════════════╗"
        + Style.RESET_ALL
    )

    print(
        Fore.CYAN
        + "║"
        + Style.BRIGHT
        + "                 SCAN SECURITY OVERVIEW                   "
        + Style.RESET_ALL
        + Fore.CYAN
        + "║"
        + Style.RESET_ALL
    )

    print(
        Fore.CYAN
        + "╠══════════════════════════════════════════════════════════╣"
        + Style.RESET_ALL
    )

    print(summary_row("TARGET", target))
    print(summary_row("RESOLVED IP", resolved_ip))
    print(summary_row("PORT RANGE", f"{start_port} - {end_port}"))

    print(
        Fore.CYAN
        + "╠══════════════════════════════════════════════════════════╣"
        + Style.RESET_ALL
    )

    print(summary_row("OPEN PORTS", len(open_ports)))
    print(summary_row("CLOSED PORTS", len(closed_ports)))
    print(summary_row("RISK SCORE", f"{risk_score} / 100"))
    print(summary_row("SCAN TIME", f"{elapsed:.2f}s"))

    print(
        Fore.CYAN
        + "╚══════════════════════════════════════════════════════════╝"
        + Style.RESET_ALL
    )

    if closed_ports:

        closed_count = len(
            closed_ports
        )

        print(
            f"Closed Ports  : "
            f"{closed_count}"
        )

        if closed_count <= 20:

            print(
                f"Closed List   : "
                f"{closed_ports}"
            )

        else:

            print(
                "Closed List   : "
                "Hidden (too many ports)"
            )

    # ========================================================
    # FINDINGS
    # ========================================================

    print_findings(
        findings,
        risk_score
    )

    print_top_findings(
        findings
    )

    # ========================================================
    # ML
    # ========================================================

    ml_result = analyze_with_history(
        scan_data
    )

    print_ml_analysis(
        ml_result
    )

    # ========================================================
    # HYBRID
    # ========================================================

    hybrid = generate_hybrid_analysis(
        risk_score,
        ml_result
    )

    print_hybrid_analysis(
        hybrid
    )

    # ========================================================
    # AI ANALYST
    # ========================================================

    assessment = generate_security_assessment(
        findings,
        hybrid
    )

    print_ai_assessment(
        assessment
    )

    # ========================================================
    # REPORT
    # ========================================================

    report = {

        "target":
            target,

        "resolved_ip":
            resolved_ip,

        "hostname":
            hostname,

        "hostname_source":
            hostname_source,

        "ports_scanned":
            {
                "start":
                    start_port,

                "end":
                    end_port,

                "count":
                    len(ports)
            },

        "open_ports":
            open_ports,

        "closed_ports":
            closed_ports,

        "findings":
            findings,

        "risk_score":
            risk_score,

        "ml_analysis":
            ml_result,

        "hybrid_analysis":
            hybrid,

        "ai_assessment":
            assessment,

        "scan_time_seconds":
            round(
                elapsed,
                4
            )

    }

    # ========================================================
    # HISTORY + CHANGE INTELLIGENCE
    # ========================================================

    # Legacy history comparison
    comparison = compare_last_scan(
        report
    )

    report[
        "history_comparison"
    ] = comparison


    # Advanced baseline/change detection
    change_intelligence = (
        compare_current_with_baseline(
            report
        )
    )

    report[
        "change_intelligence"
    ] = change_intelligence


    # Display change intelligence
    print_change_report(
        change_intelligence
    )


    # Save current scan only AFTER comparison
    save_history(
        report
    )

    # ========================================================
    # REPORT FILES
    # ========================================================

    json_file = save_json(
        report
    )

    csv_file = save_csv(
        open_ports
    )

    print()

    print(
        Fore.YELLOW
        + f"JSON report : {json_file}"
    )

    print(
        Fore.YELLOW
        + f"CSV report  : {csv_file}"
    )



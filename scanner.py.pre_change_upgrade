# ============================================================
# TARGET / HOST
# ============================================================

def resolve_target(target):

    target = target.strip()

    if not target:
        return None

    try:

        ip = socket.gethostbyname(
            target
        )

        return ip

    except (
        socket.gaierror,
        socket.herror,
        OSError
    ):

        return None


def get_hostname(ip):

    try:

        hostname = socket.gethostbyaddr(
            ip
        )[0]

        return (
            hostname,
            "reverse_dns"
        )

    except (
        socket.herror,
        socket.gaierror,
        OSError
    ):

        return (
            "Unknown",
            "Unknown"
        )


# ============================================================
# PORT VALIDATION
# ============================================================

def validate_ports(
    start,
    end
):

    try:

        start = int(start)
        end = int(end)

    except ValueError:

        return False

    if start < 1 or end > 65535:

        return False

    if start > end:

        return False

    return True


# ============================================================
# PORT SCANNER
# ============================================================

def scan_port(
    ip,
    port,
    timeout=DEFAULT_TIMEOUT
):

    sock = socket.socket(
        socket.AF_INET,
        socket.SOCK_STREAM
    )

    sock.settimeout(
        timeout
    )

    start_time = time.time()

    try:

        result = sock.connect_ex(
            (
                ip,
                port
            )
        )

        elapsed = (
            time.time()
            - start_time
        )

        if result != 0:

            return None

        service = get_service_name(
            port
        )

        banner = get_banner(
            ip,
            port
        )

        return {

            "port":
                port,

            "protocol":
                "TCP",

            "service":
                service,

            "state":
                "open",

            "banner":
                banner,

            "latency_ms":
                round(
                    elapsed * 1000,
                    2
                )

        }

    except (
        socket.timeout,
        OSError
    ):

        return None

    finally:

        sock.close()


# ============================================================
# TARGET SCAN
# ============================================================

def scan_target(
    ip,
    ports,
    timeout=DEFAULT_TIMEOUT,
    workers=DEFAULT_WORKERS
):

    results = []

    total = len(
        ports
    )

    completed = 0

    with ThreadPoolExecutor(
        max_workers=workers
    ) as executor:

        futures = {
            executor.submit(
                scan_port,
                ip,
                port,
                timeout
            ): port

            for port in ports
        }

        for future in as_completed(
            futures
        ):

            completed += 1

            try:

                result = future.result()

                if result:

                    results.append(
                        result
                    )

                    print(
                        Fore.GREEN
                        + f"[OPEN] "
                        f"{result['port']} "
                        f"{result['service']}"
                    )

                    if result.get(
                        "banner"
                    ):

                        print(
                            "       Banner: "
                            + str(
                                result[
                                    "banner"
                                ]
                            )[:250]
                        )

            except Exception as error:

                print(
                    Fore.RED
                    + f"Scan error: {error}"
                )

            percentage = (
                completed
                / total
                * 100
            )

            print(
                f"Scanning: "
                f"{completed}/{total} "
                f"({percentage:.1f}%)",
                end="\r"
            )

    print()

    results.sort(
        key=lambda item:
            item["port"]
    )

    return results



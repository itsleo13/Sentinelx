    )

    print(
        "=" * 72
    )

    print(
        f"Total hosts          : "
        f"{profile_summary['total_hosts']}"
    )

    print(
        f"Critical hosts       : "
        f"{profile_summary['critical_hosts']}"
    )

    print(
        f"High-risk hosts      : "
        f"{profile_summary['high_risk_hosts']}"
    )

    print(
        f"Medium-risk hosts    : "
        f"{profile_summary['medium_risk_hosts']}"
    )

    print(
        f"Low-risk hosts       : "
        f"{profile_summary['low_risk_hosts']}"
    )

    print(
        f"Info hosts           : "
        f"{profile_summary['info_hosts']}"

# ============================================================

def run_discovery():

    print()

    print(
        Fore.CYAN
        + "LOCAL NETWORK DISCOVERY"
    )

    network = input(
        "Enter authorized local subnet "
        "(Enter for auto): "
    ).strip()

    if not network:

        network = get_local_network()

    if not network:

        print(
            Fore.RED
            + "Could not determine local network."
        )

        return

    print(
        f"Network: {network}"
    )

    print(
        "Discovering responding hosts..."
    )

    hosts = discover_hosts(
        network
    )

    print()

    if not hosts:

        print(
            Fore.YELLOW
            + "No responding hosts found."
        )

        return

    print(
        Fore.GREEN
        + f"Hosts found: {len(hosts)}"
    )

    # ========================================================
    # HOST PROFILING
    # ========================================================

    print()

    print(
        Fore.CYAN
        + "Building host profiles..."
    )

    profiles = generate_host_profiles(
        hosts
    )

    print_host_profiles(
        profiles
    )

    # ========================================================
    # SERVICE INTELLIGENCE
    # ========================================================

    print()

    print(
        Fore.CYAN
        + "Enumerating common TCP services..."
    )

    profiles = profile_host_services(
        profiles
    )

    print_service_profiles(
        profiles
    )

    # ========================================================
    # SERVICE SUMMARY
    # ========================================================

    service_summary = summarize_services(
        profiles
    )

    print()

    print(
        "=" * 72
    )

    print(
        "SERVICE SUMMARY"
    )

    print(
        "=" * 72
    )

    print(
        f"Hosts analyzed       : "
        f"{service_summary['total_hosts']}"
    )

    print(
        f"Hosts with services  : "
        f"{service_summary['hosts_with_services']}"
    )

    print(
        f"Open services        : "
        f"{service_summary['total_open_ports']}"
